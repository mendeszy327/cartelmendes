<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Cartel Mendes</title>
<style>
:root{color-scheme:dark;--stat:url(data:image/jpeg;base64,);--bg:#070707;--card:#141414;--gold:#d4af37;--gold2:#f5e08a;--red:#a4161a;--txt:#f2ede2;--mut:#a39d8e;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth;scroll-padding-top:70px}
body{background:var(--bg);color:var(--txt);font-family:'Helvetica Neue',Arial,sans-serif;overflow-x:hidden}
h1,h2,h3,.logo{font-family:Georgia,'Times New Roman',serif;letter-spacing:.04em}
nav{position:fixed;top:0;left:0;right:0;z-index:20;display:flex;justify-content:space-between;align-items:center;padding:calc(14px + env(safe-area-inset-top,0px)) 5vw 14px;background:linear-gradient(#000d,#0000)}
.logo{font-size:1.3rem;color:var(--gold);text-transform:uppercase}
nav div{display:flex;align-items:center;gap:20px}
nav a{color:var(--txt);text-decoration:none;font-size:.8rem;text-transform:uppercase;letter-spacing:.15em;opacity:.8}
nav a:hover{color:var(--gold);opacity:1}
.acc{border:1px solid var(--gold);color:var(--gold)!important;padding:8px 20px;opacity:1!important;background:none;cursor:pointer;font:inherit;font-size:.8rem;text-transform:uppercase;letter-spacing:.15em}
.acc:hover{background:var(--gold);color:#000!important}
@media(max-width:640px){nav a.l{display:none}}
#hero{position:relative;height:100vh;min-height:620px;overflow:hidden;background:#000;display:flex;align-items:center;padding:0 5vw}
.herobg{position:absolute;inset:0;background:var(--stat) right center/auto 100% no-repeat;animation:kb 20s ease-in-out infinite alternate}
@keyframes kb{to{transform:scale(1.08)}}
#hero::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#000 20%,#000a 55%,#0000),linear-gradient(#0000 70%,var(--bg))}
@media(max-width:800px){.herobg{opacity:.4;background-position:center}#hero{text-align:center;justify-content:center}}
.hero-t{position:relative;z-index:3;max-width:640px}
.hero-t h1{font-size:clamp(2.6rem,8vw,6.5rem);line-height:1;background:linear-gradient(#fff3b0,var(--gold) 55%,#7a5c10);-webkit-background-clip:text;background-clip:text;color:transparent;text-transform:uppercase}
.hero-t p{margin-top:12px;color:var(--mut);letter-spacing:.35em;text-transform:uppercase;font-size:.75rem}
.btn{display:inline-block;margin-top:24px;padding:14px 34px;border:1px solid var(--gold);color:var(--gold);background:none;text-decoration:none;text-transform:uppercase;letter-spacing:.2em;font-size:.8rem;cursor:pointer;transition:.3s}
.btn:hover{background:var(--gold);color:#000}
section{padding:90px 5vw}
h2{font-size:clamp(1.8rem,4vw,3rem);color:var(--gold);text-transform:uppercase;text-align:center}
.sub{text-align:center;color:var(--mut);margin:10px auto 40px;max-width:560px}
.gated{display:none}body.ok .gated{display:block}body.ok #locked{display:none}
#locked{text-align:center;border-block:1px solid #2a2418;background:#0d0d0d}
#locked .ic{font-size:3rem}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px;max-width:1200px;margin:auto;perspective:1000px}
.cat,.ph{position:relative;background:var(--card);border:1px solid #2a2418;overflow:hidden;transform-style:preserve-3d;transition:transform .15s ease-out,border-color .3s}
.cat{padding:34px 24px;min-height:180px;display:flex;flex-direction:column;justify-content:flex-end}
.cat:hover,.ph:hover{border-color:var(--gold)}
.cat .ic{font-size:2.2rem;position:absolute;top:22px;right:22px}
.cat h3{color:var(--gold2);font-size:1.3rem}
.cat p{color:var(--mut);font-size:.85rem;margin-top:6px}
.gal{grid-template-columns:repeat(auto-fit,minmax(250px,1fr))}
.ph{aspect-ratio:3/4;display:flex;align-items:flex-end;background:#000 var(--stat) no-repeat}
.ph span{width:100%;padding:18px;background:linear-gradient(#0000,#000d);font-family:Georgia,serif;color:var(--gold2)}
.tag{display:inline-block;border:1px solid var(--red);color:#ff6b6b;font-size:.65rem;letter-spacing:.2em;padding:3px 8px;margin-bottom:6px;text-transform:uppercase}
footer{padding:50px 5vw;text-align:center;color:var(--mut);font-size:.8rem;border-top:1px solid #2a2418}
/* modal */
dialog{margin:auto;background:#111;color:var(--txt);border:1px solid var(--gold);padding:30px;width:min(92vw,400px)}
dialog::backdrop{background:#000b}
.tabs{display:flex;margin-bottom:20px;border-bottom:1px solid #2a2418}
.tabs button{flex:1;background:none;border:0;color:var(--mut);padding:10px;cursor:pointer;text-transform:uppercase;letter-spacing:.15em;font:inherit;font-size:.8rem}
.tabs button.on{color:var(--gold);border-bottom:2px solid var(--gold)}
input,select{width:100%;padding:12px;margin-bottom:12px;background:#000;border:1px solid #3a3220;color:var(--txt);font:inherit}
input:focus,select:focus{outline:1px solid var(--gold)}
.msg{min-height:1.3em;font-size:.85rem;margin-bottom:8px}.err{color:#ff6b6b}.okm{color:#7fd88a}
dialog .btn{width:100%;margin-top:4px}
.x{float:right;background:none;border:0;color:var(--mut);font-size:1.4rem;cursor:pointer}
/* admin */
#admin{background:#0d0d0d}
.tw{max-width:1100px;margin:auto;overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:.9rem}
th,td{padding:12px 10px;text-align:left;border-bottom:1px solid #2a2418;white-space:nowrap}
th{color:var(--gold);font-size:.7rem;text-transform:uppercase;letter-spacing:.15em}
td select,td input{width:auto;margin:0;padding:6px;font-size:.8rem}
td input{width:70px}
.sm{background:none;border:1px solid var(--gold);color:var(--gold);padding:6px 12px;cursor:pointer;font-size:.75rem;margin-left:4px}
.sm:hover{background:var(--gold);color:#000}.sm.d{border-color:var(--red);color:#ff6b6b}.sm.d:hover{background:var(--red);color:#fff}
.st{padding:3px 8px;font-size:.7rem;text-transform:uppercase;letter-spacing:.1em;border:1px solid}
.st.pending{color:#f5c542}.st.active{color:#7fd88a}.st.blocked,.st.expired{color:#ff6b6b}

#dados{background:#0d0d0d}
.q{max-width:640px;margin:auto;display:flex;gap:10px}.q input{margin:0;flex:1}.q .btn{margin:0;padding:12px 26px}
#res{max-width:900px;margin:30px auto 0}
.vd{padding:16px 20px;border:1px solid;margin-bottom:20px;font-weight:bold;letter-spacing:.05em}
.vd.g{color:#7fd88a;background:#0f2a14}.vd.y{color:#f5c542;background:#2a2410}.vd.r{color:#ff6b6b;background:#2a1010}
.rg{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1px;background:#2a2418;border:1px solid #2a2418}
.rg div{background:#111;padding:14px 16px}.rg b{display:block;color:var(--gold);font-size:.65rem;text-transform:uppercase;letter-spacing:.15em;margin-bottom:4px}.rg .w{grid-column:1/-1}
</style>
</head>
<body>
<nav><span class="logo">Cartel Mendes</span><div id="navr"></div></nav>

<header id="hero">
<div class="herobg"></div>
<div class="hero-t"><h1>Cartel Mendes</h1><p>The world is yours</p><button class="btn" id="hbtn">Acessar</button></div>
</header>

<section id="locked"><div class="ic">🔒</div><h2>Área restrita</h2><p class="sub">O conteúdo do Cartel é só para membros aprovados. Clique em Acessar, crie sua conta e aguarde a liberação.</p></section>

<section id="admin" class="gated"><h2>Painel do administrador</h2><p class="sub">Aprove cadastros e defina por quanto tempo cada pessoa terá acesso.</p><div class="tw"><table><thead><tr><th>Usuário</th><th>Status</th><th>Expira em</th><th>Ações</th></tr></thead><tbody id="rows"></tbody></table><p class="sub" id="empty" style="margin-top:30px"></p></div></section>

<section id="membros" class="gated"><h2>Área de membros</h2><p class="sub" id="wl"></p></section>

<section id="dados" class="gated"><h2>Puxar Dados</h2><p class="sub">Consulte um CNPJ na base pública da Receita Federal (via ReceitaWS) e veja se a empresa é real.</p>
<div class="q"><input id="cn" placeholder="00.000.000/0000-00" inputmode="numeric" maxlength="18"><button class="btn" id="cb">Consultar</button></div>
<div id="res"></div></section>

<footer>© 2026 Cartel Mendes. Todos os direitos reservados.</footer>

<dialog id="dlg">
<button class="x" id="cl" aria-label="Fechar">×</button>
<div class="tabs"><button id="t1" class="on">Entrar</button><button id="t2">Registrar</button></div>
<input id="u" placeholder="Usuário" autocomplete="username">
<input id="p" type="password" placeholder="Senha" autocomplete="current-password">
<input id="p2" type="password" placeholder="Confirmar senha" style="display:none" autocomplete="new-password">
<div class="msg" id="m"></div>
<button class="btn" id="go">Entrar</button>
</dialog>

<script>
var AH='6a5ff9c814e710dca982bbea3e8f27bd35025d8a491c6ab8e26b26d610e94fed',SALT='cm$';
var $=function(i){return document.getElementById(i)};
// ----- armazenamento local deste navegador -----
function ld(){try{return JSON.parse(localStorage.getItem('cm_users')||'{}')}catch(e){return {}}}
function sv(d){try{localStorage.setItem('cm_users',JSON.stringify(d))}catch(e){}}
function sess(v){try{if(v===undefined)return sessionStorage.getItem('cm_s');v?sessionStorage.setItem('cm_s',v):sessionStorage.removeItem('cm_s')}catch(e){return null}}
async function H(s){var b=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(s));return Array.from(new Uint8Array(b)).map(function(x){return x.toString(16).padStart(2,'0')}).join('')}
function valid(r){return r.status==='active'&&(r.exp===-1||r.exp>Date.now())}
function fmt(r){return r.exp===-1?'Vitalício':r.exp?new Date(r.exp).toLocaleString('pt-BR'):'—'}
// ----- interface -----
var mode='in';
function tab(m){mode=m;$('t1').className=m==='in'?'on':'';$('t2').className=m==='up'?'on':'';$('p2').style.display=m==='up'?'block':'none';$('go').textContent=m==='in'?'Entrar':'Criar conta';$('m').textContent=''}
function msg(t,ok){$('m').textContent=t;$('m').className='msg '+(ok?'okm':'err')}
function openD(){tab('in');$('u').value=$('p').value=$('p2').value='';$('dlg').showModal()}
$('t1').onclick=function(){tab('in')};$('t2').onclick=function(){tab('up')};
$('cl').onclick=function(){$('dlg').close()};
function render(){
  var u=sess(),d=ld(),adm=u==='mendes',ok=adm||(u&&d[u]&&valid(d[u]));
  document.body.className=ok?'ok':'';
  $('admin').style.display=adm?'block':'none';
  $('navr').innerHTML=u?'<a class="l" href="#dados">Puxar Dados</a>'+(adm?'<a class="l" href="#admin">Painel</a>':'')+'<button class="acc" id="out">Sair</button>':'<button class="acc" id="acc">Acessar</button>';
  if(u)$('out').onclick=function(){sess(null);render()};else $('acc').onclick=openD;
  $('hbtn').style.display=u?'none':'inline-block';
  $('wl').textContent=ok?(adm?'Bem-vindo, administrador.':'Bem-vindo, '+u+'. Seu acesso vale até: '+fmt(d[u])+'.'):'';
  if(adm)panel();
}
$('hbtn').onclick=openD;
$('go').onclick=async function(){
  var u=$('u').value.trim().toLowerCase(),p=$('p').value;
  if(!u||!p)return msg('Preencha usuário e senha.');
  var d=ld();
  if(mode==='in'){
    if(u==='mendes'){if(await H(SALT+u+'$'+p)===AH){sess('mendes');$('dlg').close();render();location.hash='#admin';return}return msg('Usuário ou senha incorretos.')}
    var r=d[u];if(!r||r.h!==await H(SALT+u+'$'+p))return msg('Usuário ou senha incorretos.');
    if(r.status==='pending')return msg('Seu cadastro ainda aguarda aprovação.');
    if(r.status==='blocked')return msg('Acesso bloqueado pelo administrador.');
    if(!valid(r))return msg('Seu acesso expirou. Fale com o administrador.');
    sess(u);$('dlg').close();render();location.hash='#membros';
  }else{
    if(!/^[a-z0-9_]{3,20}$/.test(u))return msg('Usuário: 3 a 20 letras, números ou _.');
    if(p.length<6)return msg('A senha precisa ter 6 ou mais caracteres.');
    if(p!==$('p2').value)return msg('As senhas não coincidem.');
    if(u==='mendes'||d[u])return msg('Esse usuário já existe.');
    d[u]={h:await H(SALT+u+'$'+p),status:'pending',exp:null,at:Date.now()};sv(d);
    tab('in');msg('Conta criada! Aguarde o administrador aprovar.',true);
  }
};
// ----- painel admin -----
var PR=[['1 hora',3600e3],['1 dia',864e5],['7 dias',7*864e5],['30 dias',30*864e5],['90 dias',90*864e5],['1 ano',365*864e5],['Vitalício',-1]];
function panel(){
  var d=ld(),b=$('rows'),ks=Object.keys(d);b.innerHTML='';
  $('empty').textContent=ks.length?'':'Nenhum cadastro ainda.';
  ks.sort(function(a,c){return (d[a].status==='pending'?0:1)-(d[c].status==='pending'?0:1)});
  ks.forEach(function(k){
    var r=d[k],st=r.status==='active'&&!valid(r)?'expired':r.status,tr=document.createElement('tr');
    var lb={pending:'Pendente',active:'Ativo',blocked:'Bloqueado',expired:'Expirado'}[st];
    tr.innerHTML='<td></td><td><span class="st '+st+'">'+lb+'</span></td><td>'+fmt(r)+'</td><td><select>'+PR.map(function(p,i){return '<option value="'+i+'"'+(i===2?' selected':'')+'>'+p[0]+'</option>'}).join('')+'</select> <input type="number" min="1" placeholder="dias"> <button class="sm a">'+(st==='active'?'Renovar':'Aprovar')+'</button><button class="sm d b">Bloquear</button><button class="sm d x2">Excluir</button></td>';
    tr.children[0].textContent=k;
    tr.querySelector('.a').onclick=function(){var dd=tr.querySelector('input').value,ms=dd?dd*864e5:PR[tr.querySelector('select').value][1];r.status='active';r.exp=ms===-1?-1:Date.now()+ms;sv(d);panel()};
    tr.querySelector('.b').onclick=function(){r.status='blocked';sv(d);panel()};
    tr.querySelector('.x2').onclick=function(){if(confirm('Excluir '+k+'?')){delete d[k];sv(d);panel()}};
    b.appendChild(tr)});
}
// ----- consulta CNPJ (ReceitaWS, dados públicos) -----
function esc(t){return String(t==null||t===''?'—':t).replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]})}
function okCnpj(c){if(c.length!==14||/^(\d)\1+$/.test(c))return false;function dv(n){var w=n===12?[5,4,3,2,9,8,7,6,5,4,3,2]:[6,5,4,3,2,9,8,7,6,5,4,3,2],s=0;for(var i=0;i<n;i++)s+=c[i]*w[i];var r=s%11;return r<2?0:11-r}return dv(12)==c[12]&&dv(13)==c[13]}
$('cn').oninput=function(){var v=this.value.replace(/\D/g,'').slice(0,14);this.value=v.replace(/^(\d{2})(\d)/,'$1.$2').replace(/^(\d{2})\.(\d{3})(\d)/,'$1.$2.$3').replace(/\.(\d{3})(\d)/,'.$1/$2').replace(/(\d{4})(\d)/,'$1-$2')};
$('cn').onkeydown=function(e){if(e.key==='Enter')$('cb').click()};
function vd(c,t){$('res').innerHTML='<div class="vd '+c+'">'+esc(t)+'</div>'}
function cell(l,v,w){return '<div'+(w?' class="w"':'')+'><b>'+l+'</b>'+esc(v)+'</div>'}
$('cb').onclick=async function(){
  var c=$('cn').value.replace(/\D/g,'');
  if(!okCnpj(c))return vd('r','CNPJ inválido: os dígitos verificadores não conferem.');
  vd('y','Consultando...');
  try{
    var r=await fetch('https://receitaws.com.br/v1/cnpj/'+c,{headers:{Accept:'application/json'}});
    if(r.status===429)return vd('y','Limite da API atingido (3 consultas por minuto). Aguarde um instante.');
    var j=await r.json();
    if(j.status==='ERROR')return vd('r',j.message||'CNPJ não encontrado.');
    var ativa=String(j.situacao).toUpperCase()==='ATIVA';
    var h='<div class="vd '+(ativa?'g':'y')+'">'+(ativa?'✔ Empresa REAL e ATIVA na Receita Federal':'Empresa existe, mas a situação é: '+esc(j.situacao))+'</div><div class="rg">';
    h+=cell('Razão social',j.nome,1)+cell('Nome fantasia',j.fantasia)+cell('CNPJ',j.cnpj)+cell('Tipo',j.tipo)+cell('Porte',j.porte)+cell('Abertura',j.abertura)+cell('Situação',j.situacao+' desde '+j.data_situacao)+cell('Natureza jurídica',j.natureza_juridica,1);
    h+=cell('Atividade principal',(j.atividade_principal||[]).map(function(a){return a.code+' - '+a.text}).join('; '),1);
    h+=cell('Endereço',[j.logradouro,j.numero,j.complemento,j.bairro,j.municipio+'/'+j.uf,'CEP '+j.cep].filter(Boolean).join(', '),1);
    h+=cell('Telefone',j.telefone)+cell('E-mail',j.email)+cell('Capital social','R$ '+j.capital_social);
    h+=cell('Simples Nacional',j.simples?(j.simples.optante?'Optante':'Não optante'):'—')+cell('MEI',j.simei?(j.simei.optante?'Optante':'Não optante'):'—');
    h+=cell('Sócios / administradores',(j.qsa||[]).map(function(q){return q.nome+' ('+q.qual+')'}).join('; '),1);
    h+=cell('Última atualização',j.ultima_atualizacao)+'</div>';
    $('res').innerHTML=h;
  }catch(e){vd('r','Não foi possível acessar a ReceitaWS a partir desta página. O ambiente do claude.ai bloqueia requisições a sites externos; hospede o arquivo em outro lugar (veja o arquivo para download).')}
};
render();
</script>
</body>
</html>
